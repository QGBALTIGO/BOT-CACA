+def test_archive_official_multidigit_storage_shard(settings):
+    source = InternetArchive(settings, None, None)
+    url = 'https://ia902807.us.archive.org/24/items/bv00180a/bv00180a.pdf'
+    assert source.allowed_url(url) == url
+
+
+def test_ufpb_publisher_free_pdf_retains_copyright_notice(settings):
+    source = UniversityBooks(settings, None, None, 'ufpb')
+    raw = record_html('ufpb', license=False).replace(b'</head>', (
+        '<meta name="DC.Rights" content="Copyright (c) 2021 Editora UFPB">'
+        '<meta name="DC.Source" content="Editora UFPB">'
+        '<meta name="citation_pdf_url" content="' + source.origin + source.prefix
+        + '/catalog/download/414/2/3"></head>').encode())
+    book, _ = source.parse_record(raw, '414')['pdf']
+    assert 'Copyright (c) 2021 Editora UFPB' in book.description
+    assert 'Acesso gratuito' in book.description
+    assert 'Licença:' not in book.description
+    for invalid in (raw.replace(b'citation_pdf_url', b'other_metadata'),
+                    raw.replace(b'/catalog/download/414/2/3', b'/catalog/download/999/2/3'),
+                    raw.replace(b'Copyright (c) 2021 Editora UFPB', b'Unknown rights')):
+        with pytest.raises(UserError):
+            source.parse_record(invalid, '414')
+
+
+def test_ufpb_actual_public_cover_prefix(settings):
+    source = UniversityBooks(settings, None, None, 'ufpb')
+    url = source.origin + '/press5/public/presses/1/submission_677_cover.jpg'
+    assert source.allowed_url(url) == url
